#!/bin/sh

echo "=== pre-push: gofmt ==="
UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
    echo "FAILED: the following files are not gofmt-formatted:"
    echo "$UNFORMATTED"
    echo "Run 'gofmt -w .' to fix."
    exit 1
fi

echo "=== pre-push: golangci-lint ==="
go tool -modfile=.github/tools/go.mod golangci-lint run ./... || { echo "FAILED: golangci-lint"; exit 1; }

echo "=== pre-push: build ==="
go build ./... || { echo "FAILED: build"; exit 1; }

echo "=== pre-push: test ==="
go test ./... || { echo "FAILED: test"; exit 1; }

echo "=== pre-push: coverage ==="
mkdir -p out

go test -coverprofile=out/bitbuffer.out -covermode=set ./bitbuffer/... > /dev/null 2>&1 || { echo "FAILED: bitbuffer test"; exit 1; }
BB=$(go tool cover -func=out/bitbuffer.out | grep total | awk '{print $NF}' | tr -d '%')

go test -coverprofile=out/tsparser.out -covermode=set ./tsparser/... > /dev/null 2>&1 || { echo "FAILED: tsparser test"; exit 1; }
TS=$(go tool cover -func=out/tsparser.out | grep total | awk '{print $NF}' | tr -d '%')

echo "  bitbuffer: ${BB}%"
echo "  tsparser:  ${TS}%"

if [ "$BB" != "100.0" ]; then
    echo "FAILED: bitbuffer coverage is ${BB}%, expected 100.0%"
    exit 1
fi

if [ "$TS" != "100.0" ]; then
    echo "FAILED: tsparser coverage is ${TS}%, expected 100.0%"
    exit 1
fi

echo "=== pre-push: README demo ==="
./docs/demo/render.sh --check || { echo "FAILED: README demo is stale"; exit 1; }

# The GUI checks need a Rust toolchain, so they run only when GUI sources,
# commands or toolchain configuration changed.
GUI_BASE=$(git merge-base HEAD origin/master 2>/dev/null || echo "")
if [ -n "$GUI_BASE" ] && [ -n "$(git diff --name-only "$GUI_BASE" HEAD -- gui/ Makefile mise.toml rust-toolchain.toml)" ]; then
    echo "=== pre-push: GUI ==="
    command -v cargo > /dev/null || { echo "FAILED: gui/ or Makefile changed but cargo is not installed (see docs/development/index.md)"; exit 1; }
    make gui-lint || { echo "FAILED: GUI lint"; exit 1; }
    make gui-test || { echo "FAILED: GUI test"; exit 1; }
fi

# The README screenshots are rendered on macOS, the canonical renderer; on other
# systems the GUI CI job checks them.
if [ "$(uname -s)" = Darwin ] && [ -n "$GUI_BASE" ] &&
    [ -n "$(git diff --name-only "$GUI_BASE" HEAD -- gui/ Makefile mise.toml rust-toolchain.toml docs/images/ README.md)" ]; then
    echo "=== pre-push: GUI screenshots ==="
    make check-gui-screenshots || { echo "FAILED: README screenshots are stale; run make gui-screenshots"; exit 1; }
fi

echo "=== pre-push: all checks passed ==="
