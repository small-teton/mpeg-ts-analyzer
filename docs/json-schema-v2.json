{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://small-teton.github.io/mpeg-ts-analyzer/json-schema-v2.json",
  "title": "mpeg-ts-analyzer JSON report v2",
  "description": "Schema for --format json. Objects permit additive fields and status strings permit additive lowercase values within schema version 2.",
  "type": "object",
  "required": [
    "schema_version",
    "input",
    "status",
    "programs",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "status": {
      "$ref": "#/$defs/status",
      "description": "Current values: complete, programs_listed, incomplete, failed."
    },
    "reason": {
      "$ref": "#/$defs/reasonCode",
      "description": "Stable machine-readable reason code."
    },
    "error": {
      "type": "string",
      "description": "Human-readable error detail; not a stable matching interface."
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "selected_program_number": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "sync": {
      "$ref": "#/$defs/sync"
    },
    "compliance": {
      "$ref": "#/$defs/compliance"
    },
    "continuity_counter": {
      "$ref": "#/$defs/continuity"
    },
    "transport_errors": {
      "$ref": "#/$defs/affectedPackets",
      "description": "Packets with transport_error_indicator set, over every packet of the range. Present whenever the analysis ran (status complete)."
    },
    "scrambled_packets": {
      "$ref": "#/$defs/affectedPackets",
      "description": "Packets with a non-zero transport_scrambling_control, over every packet of the range. Present whenever the analysis ran (status complete)."
    },
    "timestamp_anomalies": {
      "$ref": "#/$defs/timestampAnomalies"
    },
    "pcr_jitter": {
      "$ref": "#/$defs/pcrJitter"
    },
    "bitrate": {
      "$ref": "#/$defs/bitrate"
    },
    "psi_transitions": {
      "type": "array",
      "description": "PAT and PMT version changes applied during the analysis, in stream order. Absent when no change was applied. programs describes the layout at the start of the analysis.",
      "items": {
        "$ref": "#/$defs/psiTransition"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pid": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{4}$"
    },
    "streamType": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{2}$"
    },
    "input": {
      "type": "object",
      "required": [
        "path",
        "offset_bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "packet_size_bytes": {
          "type": "integer",
          "enum": [188, 192]
        },
        "offset_bytes": {
          "type": "integer"
        },
        "limit_bytes": {
          "type": "integer"
        }
      }
    },
    "program": {
      "type": "object",
      "required": [
        "program_number",
        "pmt_pid",
        "elementary_streams",
        "status"
      ],
      "properties": {
        "program_number": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pmt_pid": {
          "$ref": "#/$defs/pid"
        },
        "pcr_pid": {
          "$ref": "#/$defs/pid"
        },
        "elementary_streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementaryStream"
          }
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: complete, incomplete."
        },
        "reason": {
          "$ref": "#/$defs/reasonCode",
          "description": "Stable machine-readable reason code. Current value: pmt_parse_failed."
        },
        "error": {
          "type": "string",
          "description": "Human-readable error detail; not a stable matching interface."
        }
      }
    },
    "service": {
      "type": "object",
      "description": "The program's service from the SDT actual (table_id 0x42) whose service_id equals program_number; absent when the stream has no SDT or the SDT does not list the program. The fields come from the service_descriptor and are absent without one. Each name is either decoded text or, when its DVB character table is not supported, the raw bytes including the table selector as lowercase hex.",
      "properties": {
        "service_type": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{2}$"
        },
        "service_type_description": {
          "type": "string"
        },
        "provider_name": {
          "type": "string"
        },
        "provider_name_hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "name": {
          "type": "string"
        },
        "name_hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        }
      }
    },
    "elementaryStream": {
      "type": "object",
      "required": [
        "pid",
        "stream_type",
        "stream_type_description"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "stream_type": {
          "$ref": "#/$defs/streamType"
        },
        "stream_type_description": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "status",
        "limit_ms",
        "observations"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, ng, skipped."
        },
        "value_ms": {
          "type": "number"
        },
        "limit_ms": {
          "type": "number"
        },
        "observations": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "reason": {
          "type": "string",
          "description": "Human-readable skip explanation; not a stable matching interface."
        }
      }
    },
    "compliance": {
      "type": "object",
      "required": [
        "max_pcr_interval",
        "max_pcr_pts_dts_gap"
      ],
      "properties": {
        "max_pcr_interval": {
          "$ref": "#/$defs/check",
          "description": "Largest interval between consecutive comparable PCRs (continuous or wraparound steps) of the selected program, judged against 100 ms (ISO/IEC 13818-1, 2.7.2)."
        },
        "pcr_discontinuities": {
          "$ref": "#/$defs/pcrDiscontinuityCheck",
          "description": "Added within schema 2.0; absent from documents of an earlier 2.0 CLI."
        },
        "max_pcr_pts_dts_gap": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "pcrDiscontinuityCheck": {
      "type": "object",
      "required": [
        "status",
        "pcr_count",
        "undeclared_count",
        "jump_limit_ms",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, ng (at least one backward or forward_jump step without discontinuity_indicator), skipped (fewer than two PCRs)."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable skip explanation; not a stable matching interface."
        },
        "pcr_count": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "PCRs of the selected program in the range."
        },
        "undeclared_count": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Steps of kind backward or forward_jump."
        },
        "jump_limit_ms": {
          "type": "number",
          "description": "Largest forward step measured as an interval; a larger undeclared step is a forward_jump."
        },
        "items": {
          "type": "array",
          "description": "Each step kind other than continuous that occurred, in the order wraparound, declared, pcr_pid_change, backward, forward_jump.",
          "items": {
            "$ref": "#/$defs/pcrStep"
          }
        }
      }
    },
    "pcrStep": {
      "type": "object",
      "required": [
        "kind",
        "count",
        "first_offset_bytes",
        "first_jump_ms"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/status",
          "description": "Current values: wraparound, declared, pcr_pid_change, backward, forward_jump."
        },
        "count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "first_offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Byte offset of the first PCR packet of this kind."
        },
        "first_jump_ms": {
          "type": "number",
          "description": "PCR value difference to the previous PCR at that packet; for a wraparound, the interval counted across the wrap."
        }
      }
    },
    "continuityPID": {
      "type": "object",
      "required": [
        "pid",
        "label",
        "error_count"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "label": {
          "type": "string"
        },
        "error_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "sync": {
      "type": "object",
      "description": "TS synchronization of the analyzed packets: packet boundaries without the sync byte 0x47 and the realignment after each. Offsets are absolute byte offsets in the input.",
      "required": [
        "status",
        "required_sync_bytes",
        "max_resync_scan_bytes",
        "loss_count",
        "resync_count",
        "skipped_bytes",
        "trailing_partial_packet_bytes"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, recovered, lost. lost means the analysis stopped at an unrecovered loss (top-level status incomplete, reason sync_lost)."
        },
        "reason": {
          "type": "string",
          "description": "Present for lost: why no alignment was found. Human-readable; not a stable matching interface."
        },
        "required_sync_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Consecutive packets, one packet size apart, that must start with the sync byte to accept a new alignment."
        },
        "max_resync_scan_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "How far after a lost boundary a new alignment may start."
        },
        "loss_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "resync_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "skipped_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Bytes skipped by the recovered losses; they were not analyzed."
        },
        "first_loss_offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "first_resync_offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "max_skipped_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "The largest span skipped by one recovered loss."
        },
        "max_skipped_offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Offset of the loss with the largest skipped span."
        },
        "unrecovered_offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "The lost boundary where the analysis stopped; present for lost."
        },
        "trailing_partial_packet_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Size of an incomplete packet at the end of the input; 0 when there is none. Not a loss of synchronization."
        },
        "trailing_partial_packet_offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "continuity": {
      "type": "object",
      "required": [
        "status",
        "total_error_count",
        "pids"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, errors."
        },
        "total_error_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/continuityPID"
          }
        }
      }
    },
    "affectedPID": {
      "type": "object",
      "required": [
        "pid",
        "label",
        "packet_count",
        "excluded_packet_count",
        "first_offset_bytes"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "label": {
          "type": "string",
          "description": "Role of the PID in the applied layouts: PAT, PMT, PCR, video, audio, stream_type 0xNN, null for 0x1fff, or unknown."
        },
        "packet_count": {
          "type": "integer",
          "minimum": 1
        },
        "excluded_packet_count": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Packets of this PID whose payload or PCR the analysis would have read and left out instead."
        },
        "first_offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Byte offset of the PID's first affected packet (for M2TS, of its TP_extra_header)."
        }
      }
    },
    "affectedPackets": {
      "type": "object",
      "required": [
        "status",
        "packet_count",
        "excluded_packet_count",
        "pids"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok (no affected packet), affected (affected packets, none carrying data the analysis reads), data_excluded (data of at least one affected packet was left out of the analysis)."
        },
        "packet_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "excluded_packet_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "first_offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Byte offset of the first affected packet; absent when packet_count is 0."
        },
        "pids": {
          "type": "array",
          "description": "Affected PIDs in numeric order; empty when packet_count is 0.",
          "items": {
            "$ref": "#/$defs/affectedPID"
          }
        }
      }
    },
    "timestampAnomaly": {
      "type": "object",
      "required": [
        "pid",
        "kind",
        "count",
        "message"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "kind": {
          "type": "string",
          "description": "Current values: backward, wraparound, forward_gap, dts_after_pts."
        },
        "count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "timestampAnomalies": {
      "type": "object",
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, anomalies."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timestampAnomaly"
          }
        }
      }
    },
    "pcrDiscontinuity": {
      "type": "object",
      "required": [
        "offset_bytes",
        "jump_ms",
        "from_segment",
        "to_segment"
      ],
      "properties": {
        "offset_bytes": {
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/status",
          "description": "Current values: declared, pcr_pid_change, backward, forward_jump. Added within schema 2.0."
        },
        "jump_ms": {
          "type": "number"
        },
        "from_segment": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "to_segment": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "pcrJitter": {
      "type": "object",
      "description": "PCR jitter: an estimate, the delivery assessment that decides whether the estimate can be judged, and the resulting status.",
      "required": [
        "status",
        "estimate",
        "delivery"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, warning, ng (judged against ±500 ns / ±25 µs, only when delivery.assessment is constant), not_assessable (an estimate exists but delivery is not constant), skipped (no estimate could be made). skipped takes precedence over not_assessable."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable explanation for skipped and not_assessable; not a stable matching interface."
        },
        "estimate": {
          "$ref": "#/$defs/pcrJitterEstimate"
        },
        "delivery": {
          "$ref": "#/$defs/pcrDelivery"
        }
      }
    },
    "pcrJitterEstimate": {
      "type": "object",
      "description": "The jitter estimated with one model. The value fields are present when the estimate was computed (status other than skipped).",
      "required": [
        "model",
        "pcr_pids",
        "sample_count",
        "segment_count",
        "observations",
        "discontinuities"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Current values: byte_position (the expected PCR is interpolated from its neighbors by byte position, which assumes constant delivery)."
        },
        "pcr_pids": {
          "type": "array",
          "description": "PIDs the PCRs were taken from, in order of first appearance.",
          "items": {
            "$ref": "#/$defs/pid"
          }
        },
        "sample_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "segment_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "observations": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "PCRs with a neighbor on both sides in their segment, each giving one jitter value."
        },
        "max_abs_jitter_ns": {
          "type": "number",
          "minimum": 0,
          "description": "Largest |jitter|, the value the status is judged on."
        },
        "max_abs_jitter_offset_bytes": {
          "type": "integer"
        },
        "max_jitter_ns": {
          "type": "number"
        },
        "max_jitter_offset_bytes": {
          "type": "integer"
        },
        "min_jitter_ns": {
          "type": "number"
        },
        "min_jitter_offset_bytes": {
          "type": "integer"
        },
        "average_absolute_jitter_ns": {
          "type": "number",
          "minimum": 0
        },
        "within_500ns_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "discontinuities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pcrDiscontinuity"
          }
        }
      }
    },
    "pcrDelivery": {
      "type": "object",
      "description": "Whether the stream supports the constant-delivery premise of the byte_position model, from its multiplex rate over windows of at least window_seconds of PCR time.",
      "required": [
        "assessment",
        "reason",
        "window_seconds",
        "window_count",
        "tolerance_percent",
        "plausible_jitter_limit_ns"
      ],
      "properties": {
        "assessment": {
          "$ref": "#/$defs/status",
          "description": "Current values: constant, variable, unknown."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable explanation of the assessment; not a stable matching interface."
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "window_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "average_rate_bps": {
          "type": "number",
          "minimum": 0,
          "description": "Multiplex rate over all windows (transport-stream bytes, all PIDs). Present when window_count > 0."
        },
        "min_window_rate_bps": {
          "type": "number",
          "minimum": 0
        },
        "max_window_rate_bps": {
          "type": "number",
          "minimum": 0
        },
        "max_deviation_percent": {
          "type": "number",
          "minimum": 0,
          "description": "Largest deviation of a window rate from average_rate_bps. Present when window_count >= 2."
        },
        "tolerance_percent": {
          "type": "number",
          "minimum": 0
        },
        "plausible_jitter_limit_ns": {
          "type": "number",
          "minimum": 0,
          "description": "A larger estimated |jitter| makes the delivery variable."
        }
      }
    },
    "bitratePID": {
      "type": "object",
      "required": [
        "pid",
        "label",
        "average_bps"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "label": {
          "type": "string"
        },
        "average_bps": {
          "type": "number",
          "minimum": 0
        },
        "peak_1s_bps": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "bitrate": {
      "type": "object",
      "required": [
        "status",
        "duration_seconds",
        "segment_count",
        "pids",
        "program_average_bps"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, skipped."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable skip explanation; not a stable matching interface."
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "segment_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pids": {
          "type": "array",
          "description": "Selected-program PIDs included in program totals.",
          "items": {
            "$ref": "#/$defs/bitratePID"
          }
        },
        "null_pid": {
          "$ref": "#/$defs/bitratePID",
          "description": "Mux-wide NULL stuffing, excluded from program totals."
        },
        "program_average_bps": {
          "type": "number",
          "minimum": 0
        },
        "program_peak_1s_bps": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "psiTransition": {
      "type": "object",
      "description": "One applied PAT or PMT version change. The new layout applies to the packets after offset_bytes. PAT changes carry programs, programs_added, programs_removed and pmt_pid_changes; PMT changes carry program_number, previous_pcr_pid, pcr_pid, elementary_streams, elementary_streams_added, elementary_streams_removed and stream_type_changes.",
      "required": [
        "offset_bytes",
        "table",
        "pid",
        "previous_version",
        "version"
      ],
      "properties": {
        "offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Offset of the packet that completed the new table."
        },
        "table": {
          "$ref": "#/$defs/status",
          "description": "Current values: pat, pmt."
        },
        "pid": {
          "$ref": "#/$defs/pid",
          "description": "PID that carried the new table."
        },
        "previous_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "description": "Equal to previous_version only for the first PMT read from a PMT PID the program moved to, when its content differs."
        },
        "programs": {
          "type": "array",
          "description": "Every program of the new PAT.",
          "items": {
            "$ref": "#/$defs/patProgram"
          }
        },
        "programs_added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patProgram"
          }
        },
        "programs_removed": {
