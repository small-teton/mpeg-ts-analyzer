{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://small-teton.github.io/mpeg-ts-analyzer/json-schema-v2.json",
  "title": "mpeg-ts-analyzer JSON report v2",
  "description": "Schema for --format json. Objects permit additive fields and status strings permit additive lowercase values within schema version 2.",
  "type": "object",
  "required": [
    "schema_version",
    "input",
    "status",
    "programs",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "status": {
      "$ref": "#/$defs/status",
      "description": "Current values: complete, programs_listed, incomplete, failed."
    },
    "reason": {
      "$ref": "#/$defs/reasonCode",
      "description": "Stable machine-readable reason code."
    },
    "error": {
      "type": "string",
      "description": "Human-readable error detail; not a stable matching interface."
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "selected_program_number": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "compliance": {
      "$ref": "#/$defs/compliance"
    },
    "continuity_counter": {
      "$ref": "#/$defs/continuity"
    },
    "timestamp_anomalies": {
      "$ref": "#/$defs/timestampAnomalies"
    },
    "pcr_jitter": {
      "$ref": "#/$defs/pcrJitter"
    },
    "bitrate": {
      "$ref": "#/$defs/bitrate"
    },
    "psi_transitions": {
      "type": "array",
      "description": "PAT and PMT version changes applied during the analysis, in stream order. Absent when no change was applied. programs describes the layout at the start of the analysis.",
      "items": {
        "$ref": "#/$defs/psiTransition"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pid": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{4}$"
    },
    "streamType": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{2}$"
    },
    "input": {
      "type": "object",
      "required": [
        "path",
        "offset_bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "packet_size_bytes": {
          "type": "integer",
          "enum": [188, 192]
        },
        "offset_bytes": {
          "type": "integer"
        },
        "limit_bytes": {
          "type": "integer"
        }
      }
    },
    "program": {
      "type": "object",
      "required": [
        "program_number",
        "pmt_pid",
        "elementary_streams",
        "status"
      ],
      "properties": {
        "program_number": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pmt_pid": {
          "$ref": "#/$defs/pid"
        },
        "pcr_pid": {
          "$ref": "#/$defs/pid"
        },
        "elementary_streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementaryStream"
          }
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: complete, incomplete."
        },
        "reason": {
          "$ref": "#/$defs/reasonCode",
          "description": "Stable machine-readable reason code. Current value: pmt_parse_failed."
        },
        "error": {
          "type": "string",
          "description": "Human-readable error detail; not a stable matching interface."
        }
      }
    },
    "service": {
      "type": "object",
      "description": "The program's service from the SDT actual (table_id 0x42) whose service_id equals program_number; absent when the stream has no SDT or the SDT does not list the program. The fields come from the service_descriptor and are absent without one. Each name is either decoded text or, when its DVB character table is not supported, the raw bytes including the table selector as lowercase hex.",
      "properties": {
        "service_type": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{2}$"
        },
        "service_type_description": {
          "type": "string"
        },
        "provider_name": {
          "type": "string"
        },
        "provider_name_hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "name": {
          "type": "string"
        },
        "name_hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        }
      }
    },
    "elementaryStream": {
      "type": "object",
      "required": [
        "pid",
        "stream_type",
        "stream_type_description"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "stream_type": {
          "$ref": "#/$defs/streamType"
        },
        "stream_type_description": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "status",
        "limit_ms",
        "observations"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, ng, skipped."
        },
        "value_ms": {
          "type": "number"
        },
        "limit_ms": {
          "type": "number"
        },
        "observations": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "reason": {
          "type": "string",
          "description": "Human-readable skip explanation; not a stable matching interface."
        }
      }
    },
    "compliance": {
      "type": "object",
      "required": [
        "max_pcr_interval",
        "max_pcr_pts_dts_gap"
      ],
      "properties": {
        "max_pcr_interval": {
          "$ref": "#/$defs/check"
        },
        "max_pcr_pts_dts_gap": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "continuityPID": {
      "type": "object",
      "required": [
        "pid",
        "label",
        "error_count"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "label": {
          "type": "string"
        },
        "error_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "continuity": {
      "type": "object",
      "required": [
        "status",
        "total_error_count",
        "pids"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, errors."
        },
        "total_error_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/continuityPID"
          }
        }
      }
    },
    "timestampAnomaly": {
      "type": "object",
      "required": [
        "pid",
        "kind",
        "count",
        "message"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "kind": {
          "type": "string",
          "description": "Current values: backward, wraparound, forward_gap, dts_after_pts."
        },
        "count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "timestampAnomalies": {
      "type": "object",
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, anomalies."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timestampAnomaly"
          }
        }
      }
    },
    "pcrDiscontinuity": {
      "type": "object",
      "required": [
        "offset_bytes",
        "jump_ms",
        "from_segment",
        "to_segment"
      ],
      "properties": {
        "offset_bytes": {
          "type": "integer"
        },
        "jump_ms": {
          "type": "number"
        },
        "from_segment": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "to_segment": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "pcrJitter": {
      "type": "object",
      "description": "PCR jitter: an estimate, the delivery assessment that decides whether the estimate can be judged, and the resulting status.",
      "required": [
        "status",
        "estimate",
        "delivery"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, warning, ng (judged against ±500 ns / ±25 µs, only when delivery.assessment is constant), not_assessable (an estimate exists but delivery is not constant), skipped (no estimate could be made). skipped takes precedence over not_assessable."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable explanation for skipped and not_assessable; not a stable matching interface."
        },
        "estimate": {
          "$ref": "#/$defs/pcrJitterEstimate"
        },
        "delivery": {
          "$ref": "#/$defs/pcrDelivery"
        }
      }
    },
    "pcrJitterEstimate": {
      "type": "object",
      "description": "The jitter estimated with one model. The value fields are present when the estimate was computed (status other than skipped).",
      "required": [
        "model",
        "pcr_pids",
        "sample_count",
        "segment_count",
        "observations",
        "discontinuities"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Current values: byte_position (the expected PCR is interpolated from its neighbors by byte position, which assumes constant delivery)."
        },
        "pcr_pids": {
          "type": "array",
          "description": "PIDs the PCRs were taken from, in order of first appearance.",
          "items": {
            "$ref": "#/$defs/pid"
          }
        },
        "sample_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "segment_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "observations": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "PCRs with a neighbor on both sides in their segment, each giving one jitter value."
        },
        "max_abs_jitter_ns": {
          "type": "number",
          "minimum": 0,
          "description": "Largest |jitter|, the value the status is judged on."
        },
        "max_abs_jitter_offset_bytes": {
          "type": "integer"
        },
        "max_jitter_ns": {
          "type": "number"
        },
        "max_jitter_offset_bytes": {
          "type": "integer"
        },
        "min_jitter_ns": {
          "type": "number"
        },
        "min_jitter_offset_bytes": {
          "type": "integer"
        },
        "average_absolute_jitter_ns": {
          "type": "number",
          "minimum": 0
        },
        "within_500ns_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "discontinuities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pcrDiscontinuity"
          }
        }
      }
    },
    "pcrDelivery": {
      "type": "object",
      "description": "Whether the stream supports the constant-delivery premise of the byte_position model, from its multiplex rate over windows of at least window_seconds of PCR time.",
      "required": [
        "assessment",
        "reason",
        "window_seconds",
        "window_count",
        "tolerance_percent",
        "plausible_jitter_limit_ns"
      ],
      "properties": {
        "assessment": {
          "$ref": "#/$defs/status",
          "description": "Current values: constant, variable, unknown."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable explanation of the assessment; not a stable matching interface."
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "window_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "average_rate_bps": {
          "type": "number",
          "minimum": 0,
          "description": "Multiplex rate over all windows (transport-stream bytes, all PIDs). Present when window_count > 0."
        },
        "min_window_rate_bps": {
          "type": "number",
          "minimum": 0
        },
        "max_window_rate_bps": {
          "type": "number",
          "minimum": 0
        },
        "max_deviation_percent": {
          "type": "number",
          "minimum": 0,
          "description": "Largest deviation of a window rate from average_rate_bps. Present when window_count >= 2."
        },
        "tolerance_percent": {
          "type": "number",
          "minimum": 0
        },
        "plausible_jitter_limit_ns": {
          "type": "number",
          "minimum": 0,
          "description": "A larger estimated |jitter| makes the delivery variable."
        }
      }
    },
    "bitratePID": {
      "type": "object",
      "required": [
        "pid",
        "label",
        "average_bps"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/pid"
        },
        "label": {
          "type": "string"
        },
        "average_bps": {
          "type": "number",
          "minimum": 0
        },
        "peak_1s_bps": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "bitrate": {
      "type": "object",
      "required": [
        "status",
        "duration_seconds",
        "segment_count",
        "pids",
        "program_average_bps"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status",
          "description": "Current values: ok, skipped."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable skip explanation; not a stable matching interface."
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "segment_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pids": {
          "type": "array",
          "description": "Selected-program PIDs included in program totals.",
          "items": {
            "$ref": "#/$defs/bitratePID"
          }
        },
        "null_pid": {
          "$ref": "#/$defs/bitratePID",
          "description": "Mux-wide NULL stuffing, excluded from program totals."
        },
        "program_average_bps": {
          "type": "number",
          "minimum": 0
        },
        "program_peak_1s_bps": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "psiTransition": {
      "type": "object",
      "description": "One applied PAT or PMT version change. The new layout applies to the packets after offset_bytes. PAT changes carry programs, programs_added, programs_removed and pmt_pid_changes; PMT changes carry program_number, previous_pcr_pid, pcr_pid, elementary_streams, elementary_streams_added, elementary_streams_removed and stream_type_changes.",
      "required": [
        "offset_bytes",
        "table",
        "pid",
        "previous_version",
        "version"
      ],
      "properties": {
        "offset_bytes": {
          "$ref": "#/$defs/nonNegativeInteger",
          "description": "Offset of the packet that completed the new table."
        },
        "table": {
          "$ref": "#/$defs/status",
          "description": "Current values: pat, pmt."
        },
        "pid": {
          "$ref": "#/$defs/pid",
          "description": "PID that carried the new table."
        },
        "previous_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "description": "Equal to previous_version only for the first PMT read from a PMT PID the program moved to, when its content differs."
        },
        "programs": {
          "type": "array",
          "description": "Every program of the new PAT.",
          "items": {
            "$ref": "#/$defs/patProgram"
          }
        },
        "programs_added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patProgram"
          }
        },
        "programs_removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patProgram"
          }
        },
        "pmt_pid_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "program_number",
              "previous_pmt_pid",
              "pmt_pid"
            ],
            "properties": {
              "program_number": {
                "$ref": "#/$defs/nonNegativeInteger"
              },
              "previous_pmt_pid": {
                "$ref": "#/$defs/pid"
              },
              "pmt_pid": {
                "$ref": "#/$defs/pid"
              }
            }
          }
        },
        "program_number": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "previous_pcr_pid": {
          "$ref": "#/$defs/pid"
        },
        "pcr_pid": {
          "$ref": "#/$defs/pid"
        },
        "elementary_streams": {
          "type": "array",
          "description": "Every elementary stream of the new PMT.",
          "items": {
            "$ref": "#/$defs/elementaryStream"
          }
        },
        "elementary_streams_added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementaryStream"
          }
        },
        "elementary_streams_removed": {
          "type": "array",
          "description": "Removed streams with their previous stream_type.",
          "items": {
            "$ref": "#/$defs/elementaryStream"
          }
        },
        "stream_type_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pid",
              "previous_stream_type",
              "stream_type",
              "stream_type_description"
            ],
            "properties": {
              "pid": {
                "$ref": "#/$defs/pid"
              },
              "previous_stream_type": {
                "$ref": "#/$defs/streamType"
              },
              "stream_type": {
                "$ref": "#/$defs/streamType"
              },
              "stream_type_description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "patProgram": {
      "type": "object",
      "required": [
        "program_number",
        "pmt_pid"
      ],
      "properties": {
        "program_number": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pmt_pid": {
          "$ref": "#/$defs/pid"
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "offset_bytes",
        "message"
      ],
      "properties": {
        "offset_bytes": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
