{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "* * * * 1"
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "packageRules": [
    {
      "description": "Keep all Go runtime pins on the latest stable release",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "groupName": "Go toolchain"
    },
    {
      "description": "Group mise and container Go runtime pins",
      "matchManagers": [
        "mise",
        "dockerfile"
      ],
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain"
    },
    {
      "description": "Group application Go dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "/^go\\.mod$/"
      ],
      "matchDepTypes": [
        "require",
        "indirect"
      ],
      "groupName": "Go dependencies"
    },
    {
      "description": "Group CI tool dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "/^\\.github\\/tools\\/go\\.mod$/"
      ],
      "matchDepTypes": [
        "tool",
        "require",
        "indirect"
      ],
      "groupName": "CI tools"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
