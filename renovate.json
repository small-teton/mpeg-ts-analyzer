{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigests",
    ":timezone(Asia/Tokyo)",
    "schedule:weekly",
    ":maintainLockFilesWeekly",
    "security:minimumReleaseAgeCrate",
    "customManagers:githubActionsVersions"
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/docs-site/requirements\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "constraints": {
    "python": "3.15"
  },
  "packageRules": [
    {
      "description": "Keep all Go runtime pins on the latest stable release",
      "matchPackageNames": [
        "go",
        "golang",
        "golang/go"
      ],
      "rangeStrategy": "bump",
      "groupName": "Go toolchain"
    },
    {
      "description": "Skip digest-only rebuilds of the dev and demo base images; version bumps still update the digest",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "Group application Go dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "/^go\\.mod$/"
      ],
      "matchDepTypes": [
        "require",
        "indirect"
      ],
      "groupName": "Go dependencies"
    },
    {
      "description": "Group CI tool dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "/^\\.github\\/tools\\/go\\.mod$/"
      ],
      "matchDepTypes": [
        "tool",
        "require",
        "indirect"
      ],
      "groupName": "CI tools"
    },
    {
      "description": "Group Rust crates of the GUI; Cargo.lock maintenance runs weekly through :maintainLockFilesWeekly",
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Group the documentation site toolchain (mkdocs.yml); requirements.txt is compiled from requirements.in with hashes",
      "matchManagers": [
        "pip-compile"
      ],
      "groupName": "Documentation site"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ],
  "vulnerabilityAlerts": {
    "description": "Security fixes bypass the weekly schedule, the crate release-age delay and major-update approval, but are never automerged",
    "schedule": [],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "automerge": false,
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true
}
